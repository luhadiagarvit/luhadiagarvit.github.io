---
import PageLayout from "@/layouts/Base.astro";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

interface Stub {
	slug: string;
	raw: string;
	inboundFrom: string[];
}
interface GraphData {
	generated: string;
	nodes: unknown[];
	edges: unknown[];
	stubs: Stub[];
}

// v3 step 6 — read graph.json (written by scripts/build-graph.mjs in
// the astro:build:start hook) and list any wikilink targets that don't
// resolve to a published note. Sorted by inbound count desc so the
// most-requested missing notes float to the top. If the file isn't
// there yet (cold start, dev preview without a prior build) we render
// the empty state.
let stubs: Stub[] = [];
try {
	const path = resolve("./public/_data/graph.json");
	const raw = readFileSync(path, "utf8");
	const data = JSON.parse(raw) as GraphData;
	stubs = (data.stubs ?? [])
		.slice()
		.sort((a, b) => b.inboundFrom.length - a.inboundFrom.length);
} catch {
	stubs = [];
}

const meta = {
	title: "stubs",
	description: "Wikilinks pointing at notes I haven't written yet.",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-4 text-2xl">stubs</h1>
	<p class="text-muted max-w-prose mb-6 text-sm leading-relaxed">
		These are <code>[[wikilinks]]</code> in published notes that don't have a target yet.
		Sorted by how many notes point at them. If something here interests you,
		<a class="cactus-link" href="/contact/">tell me</a> and I'll prioritize writing it.
	</p>
	{
		stubs.length === 0 ? (
			<p class="text-muted text-sm">No stubs yet — every link has a target.</p>
		) : (
			<ol class="stubs-list">
				{stubs.map((s) => (
					<li class="stubs-row">
						<span class="stubs-link">[[{s.raw}]]</span>
						<span class="stubs-meta">
							{s.inboundFrom.length} reference{s.inboundFrom.length === 1 ? "" : "s"}
						</span>
						<a class="stubs-cta cactus-link" href={`/contact/?topic=stub-${s.slug}`}>
							write this →
						</a>
					</li>
				))}
			</ol>
		)
	}
</PageLayout>
