---
import PageLayout from "@/layouts/Base.astro";
import NoteGraph from "@/components/graph/NoteGraph.astro";

const meta = {
	title: "graph",
	description: "Force-directed graph of all published notes and their wikilinks.",
};
---

<PageLayout meta={meta}>
	<section class="mb-8">
		<h1 class="title mb-4 text-2xl">graph</h1>
		<p class="text-muted max-w-prose text-sm leading-relaxed">
			Each node is a note. Edges are <code>[[wikilinks]]</code>. Click a node to open it.
		</p>
	</section>

	<NoteGraph />
</PageLayout>
