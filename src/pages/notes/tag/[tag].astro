---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import PageLayout from "@/layouts/Base.astro";
import NoteCard from "@/components/NoteCard.astro";

export async function getStaticPaths() {
	const notes = await getCollection("notes", ({ data }) => !data.draft);
	const byTag = new Map<string, CollectionEntry<"notes">[]>();
	for (const note of notes) {
		for (const tag of note.data.tags) {
			const list = byTag.get(tag) ?? [];
			list.push(note);
			byTag.set(tag, list);
		}
	}
	return Array.from(byTag.entries()).map(([tag, notesForTag]) => ({
		params: { tag },
		props: {
			tag,
			notes: notesForTag.sort(
				(a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
			),
		},
	}));
}

interface Props {
	tag: string;
	notes: CollectionEntry<"notes">[];
}

const { tag, notes } = Astro.props;

const meta = {
	title: `#${tag}`,
	description: `Notes tagged #${tag}.`,
};
---

<PageLayout meta={meta}>
	<section class="mb-10">
		<h1 class="title mb-4 text-2xl">#{tag}</h1>
		<p class="text-muted max-w-prose text-sm">
			<a class="cactus-link" href="/notes/tag/">all tags</a>
		</p>
	</section>

	<ul class="space-y-8" role="list">
		{
			notes.map((note) => (
				<li>
					<NoteCard note={note} />
				</li>
			))
		}
	</ul>
</PageLayout>
