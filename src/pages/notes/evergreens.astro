---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/Base.astro";
import NoteCard from "@/components/NoteCard.astro";

const evergreens = (
	await getCollection("notes", ({ data }) => !data.draft && data.kind === "evergreen")
).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const meta = {
	title: "Evergreens",
	description: "Notes I keep returning to.",
};
---

<PageLayout meta={meta}>
	<section class="mb-10">
		<h1 class="title mb-4 text-2xl">Evergreens</h1>
		<p class="text-muted max-w-prose text-sm leading-relaxed">
			Notes I keep returning to.
		</p>
	</section>

	{
		evergreens.length === 0 ? (
			<p class="text-muted max-w-prose text-sm italic">No evergreens yet.</p>
		) : (
			<ul class="space-y-8" role="list">
				{evergreens.map((note) => (
					<li>
						<NoteCard note={note} />
					</li>
				))}
			</ul>
		)
	}
</PageLayout>
