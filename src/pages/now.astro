---
import { execSync } from "node:child_process";
import Commitments from "@/components/now/Commitments.astro";
import Listening from "@/components/now/Listening.astro";
import MoodGrid from "@/components/now/MoodGrid.astro";
import Portrait from "@/components/now/Portrait.astro";
import Strava from "@/components/now/Strava.astro";
import PageLayout from "@/layouts/Base.astro";

const meta = { title: "Now", description: "What Garvit Luhadia is up to right now." };

let stamp: { hash: string; date: string; daysAgo: number } | null = null;
try {
	const raw = execSync(
		'git log -1 --format="%H %ai" -- src/pages/now.astro src/content/commitments',
		{ encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] },
	).trim();
	if (raw) {
		const parts = raw.split(/\s+(.+)/);
		const hash = parts[0];
		const isoDate = parts[1];
		if (hash && isoDate) {
			const d = new Date(isoDate);
			const ms = Date.now() - d.getTime();
			const daysAgo = Math.max(0, Math.floor(ms / 86_400_000));
			const date = d.toISOString().slice(0, 10);
			stamp = { hash: hash.slice(0, 7), date, daysAgo };
		}
	}
} catch {
	/* fall through to null stamp */
}

const repoUrl = "https://github.com/luhadiagarvit/luhadiagarvit.github.io";
---

<PageLayout meta={meta}>
	<h1 class="title mb-2 text-2xl">Now</h1>
	{
		stamp && (
			<div class="now-stamp">
				last updated <b>{stamp.daysAgo} {stamp.daysAgo === 1 ? "day" : "days"} ago</b>
				· {stamp.date}
				· commit{" "}
				<a href={`${repoUrl}/commit/${stamp.hash}`} rel="noreferrer" target="_blank">
					{stamp.hash}
				</a>
			</div>
		)
	}
	<p class="text-muted max-w-prose mb-10 text-sm leading-relaxed">
		A <a class="cactus-link" href="https://nownownow.com/about" rel="noreferrer" target="_blank">/now page</a>
		— what I'm focused on this quarter, plus signals from the rest of my life.
	</p>

	<Commitments />
	<MoodGrid />
	<Portrait />
	<Strava />
	<Listening />
</PageLayout>
